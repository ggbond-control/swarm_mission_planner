<?xml version="1.0"?>
<package format="3">
  <name>swarm_mission_planner</name>
  <version>0.1.0</version>
  <description>Native capability mission planning with a ROS 2 adapter.</description>
  <maintainer email="robot@example.com">Robot Inspection Team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <build_depend>boost</build_depend>
  <depend>opencv</depend>
  <depend>yaml_cpp_vendor</depend>
  <depend>nlohmann-json-dev</depend>
  <exec_depend>swarm_protocol</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pil</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
